# RescueTime API config.
#
# Copy to ~/.config/rescuetime/env and fill in. Never commit the real file.
#   cp .config/rescuetime/env.example ~/.config/rescuetime/env
#   chmod 600 ~/.config/rescuetime/env
#
# Key is created at https://www.rescuetime.com/anapi/manage
# Leave "Allow queries from" empty unless every machine using the key has a
# static IP. A filled-in value silently rejects requests from anywhere else.

RT_KEY="your_api_key_here"

# Where exports land. Optional. Defaults to $HOME/rescuetime-export.
RT_OUT="$HOME/Dropbox/Backup Files/RescueTime/rescuetime-export"
